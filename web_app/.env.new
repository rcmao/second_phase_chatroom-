# TKI智能干预聊天机器人Web应用环境变量

# Flask配置
SECRET_KEY=your-secret-key-here-change-this-in-production
FLASK_ENV=development
FLASK_DEBUG=True

# 数据库配置
DATABASE_URL=sqlite:///chatbot.db

# OpenAI配置
OPENAI_API_KEY=sk-XGGe5y0ZvLcQVFp6XnRizs7q47gsVnAbZx0Xr2mfcVlbr99f
OPENAI_BASE_URL=https://api2.aigcbest.top/v1
OPENAI_API_BASE=https://api2.aigcbest.top/v1

# LLM模型配置
LLM_MODEL=gpt-4o-mini
LLM_TOXICITY_MODEL=gpt-4o-mini
LLM_MESSAGE_MODEL=gpt-4o-mini
LLM_TIMEOUT_SEC=5.0

# LLM功能开关
LLM_ENABLED=true
LLM_TOXICITY_ENABLED=true
LLM_INTERVENTION_ENABLED=true
LLM_CONFIDENCE_THRESHOLD=0.7

# === 沉默检测配置 ===
SILENCE_THRESHOLD=60

# === 检测模式配置 ===
DETECTION_MODE=hybrid
CONFLICT_DETECTION_MODE=hybrid
TOXICITY_ZERO_TOLERANCE=true
CONFLICT_MODE=proactive

# === 干预冷却配置 ===
GLOBAL_COOLDOWN=30
AGENDA_TRANSITION_THRESHOLD=30
AGENDA_TRANSITION_COOLDOWN=60
GENERIC_PULLBACK_COOLDOWN=90
TOPIC_PULLBACK_COOLDOWN=120
GUIDANCE_COOLDOWN=180

# === 话题检测配置 ===
FOOTBALL_ON_TOPIC_RATIO=0.3

# === 最小检测门槛 ===
MIN_CONFLICT_ROUNDS=3

# === 干预语气 ===
INTERVENTION_TONE=warm

# === 服务器配置 ===
HOST=0.0.0.0
PORT=8080

